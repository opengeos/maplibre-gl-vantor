{
  "name": "maplibre-gl-vantor",
  "version": "0.1.0",
  "description": "A MapLibre GL JS plugin for searching and visualizing Vantor Open Data STAC catalog",
  "type": "module",
  "main": "dist/maplibre-gl-vantor.umd.js",
  "module": "dist/maplibre-gl-vantor.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maplibre-gl-vantor.es.js",
      "require": "./dist/maplibre-gl-vantor.umd.js"
    },
    "./style.css": "./dist/maplibre-gl-vantor.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deck.gl/core": {
      "optional": true
    },
    "@deck.gl/mapbox": {
      "optional": true
    },
    "@developmentseed/deck.gl-geotiff": {
      "optional": true
    },
    "geotiff-geokeys-to-proj4": {
      "optional": true
    },
    "proj4": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@developmentseed/deck.gl-geotiff": "^0.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.0.0",
    "geotiff-geokeys-to-proj4": "^2024.4.13",
    "maplibre-gl": "^4.7.0",
    "prettier": "^3.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "keywords": [
    "maplibre",
    "stac",
    "vantor",
    "satellite",
    "cog",
    "geospatial",
    "deck.gl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengeos/maplibre-gl-vantor"
  }
}
